// QUEUE: FIFO means First In, First Out.
// The first ID inserted is the first ID removed.
// Store task IDs, then use findTaskIndex() to access task details.
queue<int> pendingQueue;
// 1. Rebuild the queue so it contains only tasks that are not completed.
// swap() clears the old queue efficiently.
void rebuildPendingQueue()
{
    queue<int> emptyQueue;
    pendingQueue.swap(emptyQueue);
    for (const Task &t : tasks)
    {
        if (t.status != "Completed")
            pendingQueue.push(t.id); // push() inserts at the rear.
    }
}
// 2. Display the next pending task.
// front() reads the first ID but does not remove it.
void nextPendingTask()
{
    rebuildPendingQueue();
    if (pendingQueue.empty()) // Always check before front().
    {
        cout << "No pending tasks!\n";
        return;
    }
    int id = pendingQueue.front();
    int index = findTaskIndex(id);
    if (index != -1)
    {
        cout << "\nNext pending task:\n";
        tasks[index].display();
    }
}
// 3. Display every task in queue order.
// A temporary copy is popped so the original queue is preserved.
void displayPendingQueue()
{
    rebuildPendingQueue();
    if (pendingQueue.empty())
    {
        cout << "No pending tasks!\n";
        return;
    }
    queue<int> temp = pendingQueue;
    cout << "\nPENDING TASKS:\n";
    while (!temp.empty())
    {
        int id = temp.front();
        int index = findTaskIndex(id);
        if (index != -1)
            tasks[index].display();
        temp.pop(); // Removes front element from the temporary queue.
    }
}
// 4. Return the number of pending task IDs.
int getPendingQueueSize()
{
    rebuildPendingQueue();
    return static_cast<int>(pendingQueue.size());
}
// 5. Check whether the pending queue is empty.
bool isPendingQueueEmpty()
{
    rebuildPendingQueue();
    return pendingQueue.empty();
}
// 6. Return the front task ID, or -1 when no task is pending.
int getFrontPendingTaskId()
{
    rebuildPendingQueue();
    if (pendingQueue.empty())
        return -1;
    return pendingQueue.front();
}
// 7. Return the rear task ID, or -1 when no task is pending.
int getRearPendingTaskId()
{
    rebuildPendingQueue();
    if (pendingQueue.empty())
        return -1;
    return pendingQueue.back();
}
// 8. Convert queue IDs to a vector.
// Queue has no normal iterators, so process a copy.
vector<int> getPendingTaskIds()
{
    rebuildPendingQueue();
    vector<int> ids;
    queue<int> temp = pendingQueue;
    while (!temp.empty())
    {
        ids.push_back(temp.front());
        temp.pop();
    }
    return ids;
}
// 9. Check whether a particular ID is in the pending queue.
bool isTaskIdPending(int requiredId)
{
    rebuildPendingQueue();
    queue<int> temp = pendingQueue;
    while (!temp.empty())
    {
        if (temp.front() == requiredId)
            return true;
        temp.pop();
    }
    return false;
}
