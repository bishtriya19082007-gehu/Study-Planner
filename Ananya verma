// 22. Sort tasks by priority, then by date.
// priorityRank(): High = 3, Medium = 2, Low = 1.
void sortTasksByPriority()
{
    sort(tasks.begin(), tasks.end(),
         [](const Task &a, const Task &b)
         {
             int pa = priorityRank(a.priority);
             int pb = priorityRank(b.priority);
             if (pa == pb)
                 return dateKey(a.date) < dateKey(b.date);
             return pa > pb;
         });
    rebuildPendingQueue();
    cout << "Tasks sorted by priority and date.\n";
}
// 23. Sort tasks from earliest due date to latest due date.
void sortTasksByDate()
{
    sort(tasks.begin(), tasks.end(),
         [](const Task &a, const Task &b)
         {
             return dateKey(a.date) < dateKey(b.date);
         });
    rebuildPendingQueue();
    cout << "Tasks sorted by due date.\n";
}
// 24. stable_sort() preserves the relative order of equivalent elements.
void stableSortTasksByPriority()
{
    stable_sort(tasks.begin(), tasks.end(),
                [](const Task &a, const Task &b)
                {
                    return priorityRank(a.priority) >
                           priorityRank(b.priority);
                });
    rebuildPendingQueue();
}
