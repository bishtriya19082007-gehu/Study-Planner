// STL: transform() applies an operation to every item in a range.
// Here it converts each character into lowercase.
string toLowerCase(string s)
{
    transform(s.begin(), s.end(), s.begin(),
              [](unsigned char c)
              {
                  return static_cast<char>(tolower(c));
              });
    return s;
}
// 13. Remove spaces from the beginning and end of a string.
// find_if_not() locates the first character that is not whitespace.
string trimText(const string &input)
{
    auto first = find_if_not(
        input.begin(), input.end(),
        [](unsigned char c) { return isspace(c); });
    if (first == input.end())
        return "";
    auto last = find_if_not(
        input.rbegin(), input.rend(),
        [](unsigned char c) { return isspace(c); }).base();
    return string(first, last);
}
// 14. Search for text without considering uppercase/lowercase.
bool containsText(const string &textValue, const string &searchValue)
{
    string a = toLowerCase(textValue);
    string b = toLowerCase(searchValue);
    return a.find(b) != string::npos;
}
// 15. find_if() searches the tasks vector using a condition.
// Return the vector index, or -1 if the ID does not exist.
int findTaskUsingSTL(int requiredId)
{
    auto it = find_if(
        tasks.begin(), tasks.end(),
        [requiredId](const Task &t)
        {
            return t.id == requiredId;
        });
    if (it == tasks.end())
        return -1;
    return static_cast<int>(distance(tasks.begin(), it));
}
// 16. Search the first task whose subject or topic matches a keyword.
void searchFirstMatchingTask(const string &keyword)
{
    string key = toLowerCase(trimText(keyword));
    auto it = find_if(
        tasks.begin(), tasks.end(),
        [&key](const Task &t)
        {
            return containsText(t.subject, key) ||
                   containsText(t.topic, key);
        });
    if (it != tasks.end())
        it->display();
    else
        cout << "No matching task found.\n";
}
