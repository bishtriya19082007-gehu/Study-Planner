// 29. max() and min() keep progress between 0 and 100.
int validateProgressValue(int value)
{
    return max(0, min(100, value));
}
// 30. Update progress using STL search and range validation.
void updateProgressUsingSTL(int taskId, int newProgress)
{
    int index = findTaskUsingSTL(taskId);
    if (index == -1)
    {
        cout << "Task not found.\n";
        return;
    }
    tasks[index].progress = validateProgressValue(newProgress);
    if (tasks[index].progress == 100)
        tasks[index].status = "Completed";
    else
        tasks[index].status = "Pending";
    rebuildPendingQueue();
}
